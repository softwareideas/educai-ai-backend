          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"query\": \"cardiac cycle\",\n    \"topic\": \"Human Physiology\",\n    \"limit\": 5\n}"
        },
        "url": {
          "raw": "http://localhost:8080/search",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["search"]
        },
        "description": "Search the knowledge base with optional topic filtering"
      }
    },
