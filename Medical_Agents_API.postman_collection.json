{
  "info": {
    "name": "Medical Agents API with RAG",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for testing Medical Agents API with RAG (Retrieval-Augmented Generation) endpoints"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["health"]
        },
        "description": "Check if the API is running and healthy with RAG status"
      }
    },
    {
      "name": "List Agents",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/agents",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["agents"]
        },
        "description": "Get list of all available medical agents"
      }
    },
    {
      "name": "Home",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": [""]
        },
        "description": "Get API information and available endpoints"
      }
    },
    {
      "name": "Ask Single Agent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"question\": \"What is the mechanism of action of aspirin?\",\n    \"agent\": \"pharmacology\",\n    \"context\": {\n        \"topic\": \"cardiovascular\",\n        \"difficulty\": \"intermediate\"\n    }\n}"
        },
        "url": {
          "raw": "http://localhost:8080/ask",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["ask"]
        },
        "description": "Ask a question to a specific medical agent (now with RAG)"
      }
    },
    {
      "name": "Collaborative Response",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"question\": \"Explain the process of blood clotting from both physiological and biochemical perspectives\",\n    \"context\": {\n        \"topic\": \"hemostasis\",\n        \"difficulty\": \"advanced\"\n    }\n}"
        },
        "url": {
          "raw": "http://localhost:8080/collaborate",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["collaborate"]
        },
        "description": "Get collaborative response from multiple relevant agents with RAG"
      }
    },
    {
      "name": "Get RAG Context",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"question\": \"What is the structure of the heart?\",\n    \"max_tokens\": 1000\n}"
        },
        "url": {
          "raw": "http://localhost:8080/rag/context",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["rag", "context"]
        },
        "description": "Get RAG context for a specific question"
      }
    },
    {
      "name": "Knowledge Base Statistics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/knowledge/stats",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["knowledge", "stats"]
        },
        "description": "Get statistics about the RAG knowledge base"
      }
    },
